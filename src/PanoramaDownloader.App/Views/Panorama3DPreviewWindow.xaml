<Window x:Class="PanoramaDownloader.App.Views.Panorama3DPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D 全景预览"
        Width="960"
        Height="640"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#111"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Viewport3D x:Name="Viewport"
                    ClipToBounds="True"
                    MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                    MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                    MouseMove="Viewport_MouseMove"
                    MouseWheel="Viewport_MouseWheel"
                    LostMouseCapture="Viewport_LostMouseCapture">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera"
                                   Position="0,0,0"
                                   LookDirection="0,0,-1"
                                   UpDirection="0,1,0"
                                   FieldOfView="75"/>
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <AmbientLight Color="White"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <ModelVisual3D x:Name="SphereVisual"/>
        </Viewport3D>

        <Border Grid.Row="1" Background="#1E1E1E" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="拖拽旋转 · 滚轮缩放视角 · R 重置 · Esc 关闭"
                           Foreground="#AAA"
                           VerticalAlignment="Center"
                           FontSize="12"/>
                <Button DockPanel.Dock="Right"
                        Content="关闭"
                        Width="88"
                        Height="30"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Click="Close_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
