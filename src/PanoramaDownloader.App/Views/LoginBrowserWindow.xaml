<Window x:Class="PanoramaDownloader.App.Views.LoginBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录 720 云"
        Width="1080"
        Height="760"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="#F3F2EF">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#E2E0DA"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="请在下方页面完成 720 云登录"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                    <TextBlock x:Name="StatusText"
                               Text="正在加载登录页…"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#666"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新"
                            Width="72"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="Refresh_Click"/>
                    <Button Content="我已登录，关闭"
                            Width="120"
                            Height="32"
                            IsDefault="True"
                            Click="Done_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Margin="10"
                Background="White"
                BorderBrush="#E2E0DA"
                BorderThickness="1"
                CornerRadius="6">
            <wv2:WebView2 x:Name="Browser"/>
        </Border>
    </DockPanel>
</Window>
