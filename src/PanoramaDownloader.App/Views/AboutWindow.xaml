<Window x:Class="PanoramaDownloader.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F7F5">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="全景图下载工具"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1A1A1A"/>
            <TextBlock x:Name="VersionText"
                       Margin="0,6,0,0"
                       Foreground="#666"
                       FontSize="13"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#333"
                           Text="Windows 桌面端工具：检测并导出您有权访问的 720 云全景作品的瓦片包与等距柱状整图。"/>
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="免责声明"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="22" Foreground="#333"
                           Text="仅用于授权/自有内容的本地存档与二次制作。请勿抓取、传播未获授权的内容。登录须通过软件内嵌官方页面完成；本工具不会上传 Cookie 到第三方服务器。"/>
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="运行依赖"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="22" Foreground="#333"
                           Text="需要 Windows 10/11 x64，以及 Microsoft Edge WebView2 Runtime（Evergreen）。若启动失败，请安装官方 Runtime 后重试。"/>
                <TextBlock x:Name="RuntimeStatusText"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="#555"
                           FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="打开 WebView2 下载页" Height="32" Padding="12,0" Margin="0,0,12,0" Click="OpenRuntime_Click"/>
            <Button Content="关闭" Width="96" Height="32" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
