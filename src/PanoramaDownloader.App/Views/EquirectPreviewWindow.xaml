<Window x:Class="PanoramaDownloader.App.Views.EquirectPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="整图预览与贴图调整"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="#F3F2EF"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FaceTileBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#C8C5BE"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Setter Property="BorderBrush" Value="#4A90D9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="BorderBrush" Value="#3DDC97"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#3DDC97" Opacity="0.7"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="FaceTileContentTemplate">
            <Grid>
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding Rotation}"/>
                    </Image.RenderTransform>
                </Image>
                <Border Background="#99000000" VerticalAlignment="Top" Padding="4,2">
                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <Border Background="#99000000" VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="4,2">
                    <TextBlock Text="{Binding SourceBadge}" Foreground="#A8E6CF" FontSize="10"/>
                </Border>
                <Button Content="↻" Width="22" Height="22" FontSize="12" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                        ToolTip="顺时针旋转 90°"
                        Command="{Binding DataContext.RotateSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Background="White" BorderBrush="#E2E0DA" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="等距柱状预览（拖拽拼图换位后自动刷新）"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="4">
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="4"/>
                </Border>
                <TextBlock Grid.Row="2"
                           Text="{Binding StatusText}"
                           Margin="0,8,0,0"
                           Foreground="#666"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#E2E0DA" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="视角偏移" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding YawText}" FontSize="12" Foreground="#555"/>
                        <Slider Minimum="-180" Maximum="180" Value="{Binding YawDegrees}" TickFrequency="15"
                                IsSnapToTickEnabled="False" Margin="0,4,0,10"/>

                        <TextBlock Text="{Binding PitchText}" FontSize="12" Foreground="#555"/>
                        <Slider Minimum="-90" Maximum="90" Value="{Binding PitchDegrees}" Margin="0,4,0,10"/>

                        <TextBlock Text="{Binding RollText}" FontSize="12" Foreground="#555"/>
                        <Slider Minimum="-180" Maximum="180" Value="{Binding RollDegrees}" Margin="0,4,0,10"/>

                        <CheckBox Content="上下面额外旋转 180°"
                                  IsChecked="{Binding RotateUpDown180}"
                                  Margin="0,0,0,8"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#E2E0DA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="贴图换位（拖拽拼图）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="按住拼图块拖到另一格即可互换；拖过时实时预览，松手后刷新左侧整图。右下角 ↻ 旋转该面。"
                                   FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid x:Name="FacePuzzleRoot" Height="300">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="TileU" Grid.Row="0" Grid.Column="1"
                                        Style="{StaticResource FaceTileBorderStyle}" Tag="FaceTile"
                                        DataContext="{Binding SlotU}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="FaceTile_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="FaceTile_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="FaceTile_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="FaceTile_LostMouseCapture">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FaceTileContentTemplate}"/>
                                </Border>

                                <Border x:Name="TileL" Grid.Row="1" Grid.Column="0"
                                        Style="{StaticResource FaceTileBorderStyle}" Tag="FaceTile"
                                        DataContext="{Binding SlotL}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="FaceTile_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="FaceTile_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="FaceTile_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="FaceTile_LostMouseCapture">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FaceTileContentTemplate}"/>
                                </Border>

                                <Border x:Name="TileF" Grid.Row="1" Grid.Column="1"
                                        Style="{StaticResource FaceTileBorderStyle}" Tag="FaceTile"
                                        DataContext="{Binding SlotF}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="FaceTile_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="FaceTile_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="FaceTile_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="FaceTile_LostMouseCapture">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FaceTileContentTemplate}"/>
                                </Border>

                                <Border x:Name="TileR" Grid.Row="1" Grid.Column="2"
                                        Style="{StaticResource FaceTileBorderStyle}" Tag="FaceTile"
                                        DataContext="{Binding SlotR}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="FaceTile_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="FaceTile_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="FaceTile_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="FaceTile_LostMouseCapture">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FaceTileContentTemplate}"/>
                                </Border>

                                <Border x:Name="TileB" Grid.Row="1" Grid.Column="3"
                                        Style="{StaticResource FaceTileBorderStyle}" Tag="FaceTile"
                                        DataContext="{Binding SlotB}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="FaceTile_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="FaceTile_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="FaceTile_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="FaceTile_LostMouseCapture">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FaceTileContentTemplate}"/>
                                </Border>

                                <Border x:Name="TileD" Grid.Row="2" Grid.Column="1"
                                        Style="{StaticResource FaceTileBorderStyle}" Tag="FaceTile"
                                        DataContext="{Binding SlotD}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="FaceTile_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="FaceTile_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="FaceTile_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="FaceTile_LostMouseCapture">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FaceTileContentTemplate}"/>
                                </Border>
                            </Grid>

                            <Canvas IsHitTestVisible="False" Panel.ZIndex="10">
                                <Border x:Name="DragGhost"
                                        Width="80" Height="80"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        CornerRadius="6"
                                        BorderBrush="#4A90D9"
                                        BorderThickness="2"
                                        Background="#CC1A1A1A"
                                        Opacity="0.9"
                                        ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Image x:Name="DragGhostImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <RotateTransform x:Name="DragGhostRotate" Angle="0"/>
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>
                            </Canvas>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,14,0,0">
                    <Button Content="3D 旋转预览" Height="36" Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            ToolTip="用当前贴图生成球面全景，拖拽旋转查看"
                            Command="{Binding Open3DPreviewCommand}"/>
                    <Button Content="刷新预览" Height="34" Margin="0,0,0,8" Command="{Binding RefreshPreviewCommand}"/>
                    <Button Content="重置参数" Height="34" Margin="0,0,0,8" Command="{Binding ResetCommand}"/>
                    <Button Content="保存整图" Height="36" Margin="0,0,0,8" IsDefault="True" FontWeight="SemiBold" Click="Save_Click"/>
                    <Button Content="取消" Height="34" IsCancel="True" Click="Cancel_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
