<Window x:Class="PanoramaDownloader.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="520"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F7F5">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="本地设置"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#1A1A1A"/>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="下载目录" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DownloadDirBox" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                    <Button Grid.Column="1" Content="浏览…" Width="72" Height="30" Margin="8,0,0,0" Click="Browse_Click"/>
                </Grid>

                <TextBlock Text="并发数（2–16）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="ConcurrencyBox" Height="30" Margin="0,0,0,14" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="超时（秒，10–300）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TimeoutBox" Height="30" Margin="0,0,0,14" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="重试次数（0–10）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="RetryBox" Height="30" Margin="0,0,0,14" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="默认导出模式" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="ExportModeBox" Height="30" Margin="0,0,0,14">
                    <ComboBoxItem Content="仅瓦片" Tag="Tiles"/>
                    <ComboBoxItem Content="仅整图" Tag="Equirect"/>
                    <ComboBoxItem Content="瓦片 + 整图" Tag="Both"/>
                </ComboBox>

                <TextBlock Text="JPEG 质量（60–100）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="JpegBox" Height="30" Margin="0,0,0,14" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="整图最大宽度（1024–16384）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="MaxWidthBox" Height="30" Margin="0,0,0,14" VerticalContentAlignment="Center" Padding="8,0"/>

                <CheckBox x:Name="OpenFolderCheck" Content="导出成功后打开输出文件夹" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="96" Height="32" Margin="0,0,12,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="保存" Width="96" Height="32" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
